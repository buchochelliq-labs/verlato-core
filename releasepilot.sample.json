{
  "state_path": ".releasepilot_state.json",
  "suggestion_count": 1,
  "github": {
    "repo": "owner/repo",
    "token_env": "GITHUB_TOKEN"
  },
  "provider": {
    "name": "ollama",
    "model": "gemma4:latest",
    "endpoint": "http://127.0.0.1:11434/api/chat",
    "timeout_seconds": 120,
    "max_items_per_scan": 25
  },
  "targets": {
    "changelog": {
      "path": "CHANGELOG.md",
      "format": "changelog"
    },
    "github-release": {
      "path": ".github/release.md",
      "format": "github-release"
    }
  }
}
