{
  "state_path": ".releasepilot_state.json",
  "github": {
    "repo": "owner/repo",
    "token_env": "GITHUB_TOKEN"
  },
  "provider": {
    "name": "stub",
    "model": "gpt-4o-mini",
    "endpoint": "https://models.inference.ai.azure.com/chat/completions"
  },
  "targets": {
    "changelog": {
      "path": "CHANGELOG.md",
      "format": "changelog"
    },
    "github-release": {
      "path": ".github/release.md",
      "format": "github-release"
    }
  }
}
