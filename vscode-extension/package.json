{
  "name": "verlato-vscode",
  "displayName": "Verlato",
  "description": "Diff-first release notes. Understands your code changes. Writes your releases.",
  "version": "0.0.1",
  "publisher": "verlato",
  "icon": "media/verlato-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/n1ckyb/verlato.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:verlato.control",
    "onView:verlato.releases",
    "onView:verlato.activity",
    "onView:verlato.sources",
    "onCommand:verlato.openControl",
    "onCommand:verlato.openActivity",
    "onCommand:verlato.scanRepository",
    "onCommand:verlato.previewReleaseNotes",
    "onCommand:verlato.refreshRepository",
    "onCommand:verlato.refreshItems",
    "onCommand:verlato.openCommit",
    "onCommand:verlato.applyToChangelog",
    "onCommand:verlato.applyToReleaseFile",
    "onCommand:verlato.markItemReady",
    "onCommand:verlato.markItemNeedsReview",
    "onCommand:verlato.hideItem",
    "onCommand:verlato.editItemSummary",
    "onCommand:verlato.suggestItemSummary",
    "onCommand:verlato.requestModelInput",
    "onCommand:verlato.showServiceInfo",
    "onCommand:verlato.changeModel",
    "onCommand:verlato.acceptItem",
    "onCommand:verlato.unhideItem",
    "onCommand:verlato.resetItemSummary"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verlato",
          "title": "Verlato",
          "icon": "media/verlato.svg"
        }
      ]
    },
    "views": {
      "verlato": [
        {
          "id": "verlato.control",
          "name": "Control",
          "contextualTitle": "Verlato Control",
          "icon": "media/verlato.svg",
          "type": "webview"
        },
        {
          "id": "verlato.releases",
          "name": "Releases",
          "contextualTitle": "Verlato Releases",
          "icon": "media/verlato.svg",
          "type": "webview"
        },
        {
          "id": "verlato.activity",
          "name": "Activity",
          "contextualTitle": "Verlato Activity",
          "icon": "media/verlato.svg",
          "type": "webview"
        },
        {
          "id": "verlato.sources",
          "name": "Sources",
          "contextualTitle": "Verlato Sources",
          "icon": "media/verlato.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "verlato.openControl",
        "title": "Verlato: Open Control"
      },
      {
        "command": "verlato.openActivity",
        "title": "Verlato: View Activity"
      },
      {
        "command": "verlato.scanRepository",
        "title": "Verlato: Scan Repository"
      },
      {
        "command": "verlato.previewReleaseNotes",
        "title": "Verlato: Preview Release Notes"
      },
      {
        "command": "verlato.refreshRepository",
        "title": "Verlato: Refresh Repository Activity"
      },
      {
        "command": "verlato.applyToChangelog",
        "title": "Verlato: Apply to CHANGELOG"
      },
      {
        "command": "verlato.applyToReleaseFile",
        "title": "Verlato: Apply to Release File"
      },
      {
        "command": "verlato.refreshItems",
        "title": "Verlato: Refresh"
      },
      {
        "command": "verlato.openCommit",
        "title": "Verlato: Open Commit"
      },
      {
        "command": "verlato.markItemReady",
        "title": "Verlato: Mark Item Ready"
      },
      {
        "command": "verlato.markItemNeedsReview",
        "title": "Verlato: Mark Item Needs Review"
      },
      {
        "command": "verlato.hideItem",
        "title": "Verlato: Hide Item"
      },
      {
        "command": "verlato.editItemSummary",
        "title": "Verlato: Edit Item Summary"
      },
      {
        "command": "verlato.suggestItemSummary",
        "title": "Verlato: Suggest Item Summary"
      },
      {
        "command": "verlato.requestModelInput",
        "title": "Verlato: Preview Model Prompt"
      },
      {
        "command": "verlato.showServiceInfo",
        "title": "Verlato: Show Service Info"
      },
      {
        "command": "verlato.changeModel",
        "title": "Verlato: Change AI Model"
      },
      {
        "command": "verlato.acceptItem",
        "title": "Verlato: Accept Item"
      },
      {
        "command": "verlato.unhideItem",
        "title": "Verlato: Unhide Item"
      },
      {
        "command": "verlato.resetItemSummary",
        "title": "Verlato: Reset Item Summary"
      }
    ],
    "configuration": {
      "title": "Verlato",
      "properties": {
        "verlato.cliPath": {
          "type": "string",
          "default": "verlato",
          "description": "Path to the Verlato CLI executable."
        },
        "verlato.modelProvider": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "configured",
            "stub",
            "mock",
            "ollama",
            "github-copilot"
          ],
          "description": "Model provider override for LLM-assisted summaries and classifications. Use configured to honor verlato.json or environment variables."
        },
        "verlato.ollamaModel": {
          "type": "string",
          "default": "gemma4:latest",
          "description": "Ollama model used when Verlato runs with the Ollama provider. Defaults to Google's latest Gemma family."
        },
        "verlato.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434/api/chat",
          "description": "Ollama chat endpoint used by Verlato."
        },
        "verlato.ollamaTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "description": "Timeout in seconds for each Ollama model request."
        },
        "verlato.ollamaStreamResponses": {
          "type": "boolean",
          "default": true,
          "description": "Stream Ollama response chunks into the Verlato request timeline while preserving the final model response."
        },
        "verlato.maxModelItems": {
          "type": "number",
          "default": 25,
          "minimum": -1,
          "description": "Maximum grouped changes in a scan before Verlato disables LLM calls to avoid fanout. Use -1 to disable the guard."
        },
        "verlato.suggestionCount": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "Number of AI description suggestions to generate for each release item."
        },
        "verlato.suggestionParallelism": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum AI suggestion requests Verlato may run at once for draft suggest in VS Code."
        },
        "verlato.suggestionTone": {
          "type": "string",
          "default": "release-note",
          "enum": [
            "release-note",
            "concise",
            "technical",
            "customer-facing"
          ],
          "description": "Tone preset used when generating AI description suggestions."
        },
        "verlato.styleGuidance": {
          "type": "string",
          "default": "",
          "description": "Optional project-specific writing guidance added to AI suggestion prompts."
        },
        "verlato.projectVocabulary": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Preferred project terms or product vocabulary to encourage in AI suggestions."
        },
        "verlato.bannedPhrases": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Phrases that generated AI suggestions should avoid; matching candidates are rejected."
        },
        "verlato.specificityFloor": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "description": "Optional minimum specificity score for generated suggestions. Leave 0 to disable specificity rejection."
        },
        "verlato.feedbackIncludeText": {
          "type": "boolean",
          "default": false,
          "description": "Persist full accepted/edited summary text in local feedback events. Disabled by default; feedback otherwise stores hashes and metrics."
        },
        "verlato.telemetry.includePromptPayloads": {
          "type": "boolean",
          "default": false,
          "description": "Include full model prompt and response payloads in live request activity. Disabled by default because prompts may include PR bodies and diff snippets."
        },
        "verlato.telemetry.includeReasoningPayloads": {
          "type": "boolean",
          "default": false,
          "description": "Include full provider-exposed reasoning text in collapsed telemetry details. Disabled by default because reasoning can be large."
        },
        "verlato.telemetry.redactPayloads": {
          "type": "boolean",
          "default": true,
          "description": "Redact likely secrets from model telemetry payloads before showing or persisting them. Keep enabled unless doing deep local debugging."
        },
        "verlato.telemetry.debugModelLogPath": {
          "type": "string",
          "default": "",
          "description": "Optional JSONL file path for model telemetry debugging. Leave empty to keep telemetry ephemeral in the VS Code session."
        },
        "verlato.notifications.successLevel": {
          "type": "string",
          "default": "visible",
          "enum": [
            "visible",
            "quiet"
          ],
          "description": "Controls success notifications for user-initiated Verlato actions. Use quiet to rely on in-view status updates."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "verlato.getStarted",
        "title": "Get started with Verlato",
        "description": "Optional shortcuts for scanning changes, reviewing suggestions, and applying draft notes from VS Code.",
        "steps": [
          {
            "id": "verlato.openControl",
            "title": "Open Verlato",
            "description": "Open the Verlato Activity Bar view to start drafting release notes.\n[Open Verlato](command:verlato.openControl)",
            "completionEvents": [
              "onView:verlato.control"
            ]
          },
          {
            "id": "verlato.configureModel",
            "title": "Configure the model",
            "description": "Choose the model provider and tone used for generated release-note suggestions.\n[Change AI Model](command:verlato.changeModel)",
            "completionEvents": [
              "onCommand:verlato.changeModel"
            ]
          },
          {
            "id": "verlato.scanRange",
            "title": "Scan a range",
            "description": "Pick a base ref and scan the repository for candidate release-note items.\n[Scan Repository](command:verlato.scanRepository)",
            "completionEvents": [
              "onCommand:verlato.scanRepository"
            ]
          },
          {
            "id": "verlato.reviewApply",
            "title": "Review and apply notes",
            "description": "Preview generated release notes, then apply them to your configured changelog or release file.\n[Preview Release Notes](command:verlato.previewReleaseNotes)",
            "completionEvents": [
              "onCommand:verlato.previewReleaseNotes"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "verlato.scanRepository",
          "when": "view == verlato.control",
          "group": "navigation"
        },
        {
          "command": "verlato.refreshRepository",
          "when": "view == verlato.control || view == verlato.releases || view == verlato.sources",
          "group": "navigation"
        },
        {
          "command": "verlato.refreshItems",
          "when": "view == verlato.control",
          "group": "navigation"
        },
        {
          "command": "verlato.openActivity",
          "when": "view == verlato.control",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "verlato.markItemReady",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "inline"
        },
        {
          "command": "verlato.markItemNeedsReview",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "inline"
        },
        {
          "command": "verlato.hideItem",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "inline"
        },
        {
          "command": "verlato.editItemSummary",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "navigation"
        },
        {
          "command": "verlato.suggestItemSummary",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "inline"
        },
        {
          "command": "verlato.requestModelInput",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "navigation"
        },
        {
          "command": "verlato.acceptItem",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "inline"
        },
        {
          "command": "verlato.unhideItem",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "navigation"
        },
        {
          "command": "verlato.resetItemSummary",
          "when": "view == verlato.control && viewItem == verlato.item",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/vscode": "^1.90.0",
    "@vscode-elements/elements": "^2.5.1",
    "typescript": "^5.6.0"
  }
}
