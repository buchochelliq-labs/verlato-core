{
  "name": "releasepilot-vscode",
  "displayName": "ReleasePilot",
  "description": "Scan repositories, preview release notes, and apply changelog updates with ReleasePilot.",
  "version": "0.0.1",
  "publisher": "releasepilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/n1ckyb/release-pilot.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:releasepilot.items",
    "onCommand:releasepilot.scanRepository",
    "onCommand:releasepilot.previewReleaseNotes",
    "onCommand:releasepilot.refreshRepository",
    "onCommand:releasepilot.refreshItems",
    "onCommand:releasepilot.applyToChangelog",
    "onCommand:releasepilot.applyToReleaseFile",
    "onCommand:releasepilot.markItemReady",
    "onCommand:releasepilot.markItemNeedsReview",
    "onCommand:releasepilot.hideItem",
    "onCommand:releasepilot.editItemSummary",
    "onCommand:releasepilot.suggestItemSummary",
    "onCommand:releasepilot.requestModelInput",
    "onCommand:releasepilot.showServiceInfo",
    "onCommand:releasepilot.changeModel",
    "onCommand:releasepilot.acceptItem",
    "onCommand:releasepilot.unhideItem",
    "onCommand:releasepilot.resetItemSummary"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "releasepilot",
          "title": "ReleasePilot",
          "icon": "media/releasepilot.svg"
        }
      ]
    },
    "views": {
      "releasepilot": [
        {
          "id": "releasepilot.items",
          "name": "Release Control",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "releasepilot.scanRepository",
        "title": "ReleasePilot: Scan Repository"
      },
      {
        "command": "releasepilot.previewReleaseNotes",
        "title": "ReleasePilot: Preview Release Notes"
      },
      {
        "command": "releasepilot.refreshRepository",
        "title": "ReleasePilot: Refresh Repository Activity"
      },
      {
        "command": "releasepilot.applyToChangelog",
        "title": "ReleasePilot: Apply to CHANGELOG"
      },
      {
        "command": "releasepilot.applyToReleaseFile",
        "title": "ReleasePilot: Apply to Release File"
      },
      {
        "command": "releasepilot.refreshItems",
        "title": "ReleasePilot: Refresh"
      },
      {
        "command": "releasepilot.markItemReady",
        "title": "ReleasePilot: Mark Item Ready"
      },
      {
        "command": "releasepilot.markItemNeedsReview",
        "title": "ReleasePilot: Mark Item Needs Review"
      },
      {
        "command": "releasepilot.hideItem",
        "title": "ReleasePilot: Hide Item"
      },
      {
        "command": "releasepilot.editItemSummary",
        "title": "ReleasePilot: Edit Item Summary"
      },
      {
        "command": "releasepilot.suggestItemSummary",
        "title": "ReleasePilot: Suggest Item Summary"
      },
      {
        "command": "releasepilot.requestModelInput",
        "title": "ReleasePilot: Preview Model Prompt"
      },
      {
        "command": "releasepilot.showServiceInfo",
        "title": "ReleasePilot: Show Service Info"
      },
      {
        "command": "releasepilot.changeModel",
        "title": "ReleasePilot: Change AI Model"
      },
      {
        "command": "releasepilot.acceptItem",
        "title": "ReleasePilot: Accept Item"
      },
      {
        "command": "releasepilot.unhideItem",
        "title": "ReleasePilot: Unhide Item"
      },
      {
        "command": "releasepilot.resetItemSummary",
        "title": "ReleasePilot: Reset Item Summary"
      }
    ],
    "configuration": {
      "title": "ReleasePilot",
      "properties": {
        "releasepilot.cliPath": {
          "type": "string",
          "default": "releasepilot",
          "description": "Path to the ReleasePilot CLI executable."
        },
        "releasepilot.modelProvider": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "configured",
            "stub",
            "mock",
            "ollama",
            "github-copilot"
          ],
          "description": "Model provider override for LLM-assisted summaries and classifications. Use configured to honor releasepilot.json or environment variables."
        },
        "releasepilot.ollamaModel": {
          "type": "string",
          "default": "gemma4:latest",
          "description": "Ollama model used when ReleasePilot runs with the Ollama provider. Defaults to Google's latest Gemma family."
        },
        "releasepilot.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434/api/chat",
          "description": "Ollama chat endpoint used by ReleasePilot."
        },
        "releasepilot.ollamaTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "description": "Timeout in seconds for each Ollama model request."
        },
        "releasepilot.ollamaStreamResponses": {
          "type": "boolean",
          "default": true,
          "description": "Stream Ollama response chunks into the ReleasePilot request timeline while preserving the final model response."
        },
        "releasepilot.maxModelItems": {
          "type": "number",
          "default": 25,
          "minimum": -1,
          "description": "Maximum grouped changes in a scan before ReleasePilot disables LLM calls to avoid fanout. Use -1 to disable the guard."
        },
        "releasepilot.suggestionCount": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "Number of AI description suggestions to generate for each release item."
        },
        "releasepilot.suggestionTone": {
          "type": "string",
          "default": "release-note",
          "enum": [
            "release-note",
            "concise",
            "technical",
            "customer-facing"
          ],
          "description": "Tone preset used when generating AI description suggestions."
        },
        "releasepilot.styleGuidance": {
          "type": "string",
          "default": "",
          "description": "Optional project-specific writing guidance added to AI suggestion prompts."
        },
        "releasepilot.projectVocabulary": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Preferred project terms or product vocabulary to encourage in AI suggestions."
        },
        "releasepilot.bannedPhrases": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Phrases that generated AI suggestions should avoid; matching candidates are rejected."
        },
        "releasepilot.specificityFloor": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "description": "Optional minimum specificity score for generated suggestions. Leave 0 to disable specificity rejection."
        },
        "releasepilot.feedbackIncludeText": {
          "type": "boolean",
          "default": false,
          "description": "Persist full accepted/edited summary text in local feedback events. Disabled by default; feedback otherwise stores hashes and metrics."
        },
        "releasepilot.telemetry.includePromptPayloads": {
          "type": "boolean",
          "default": false,
          "description": "Include full model prompt and response payloads in live request activity. Disabled by default because prompts may include PR bodies and diff snippets."
        },
        "releasepilot.telemetry.includeReasoningPayloads": {
          "type": "boolean",
          "default": false,
          "description": "Include full provider-exposed reasoning text in collapsed telemetry details. Disabled by default because reasoning can be large."
        },
        "releasepilot.telemetry.redactPayloads": {
          "type": "boolean",
          "default": true,
          "description": "Redact likely secrets from model telemetry payloads before showing or persisting them. Keep enabled unless doing deep local debugging."
        },
        "releasepilot.telemetry.debugModelLogPath": {
          "type": "string",
          "default": "",
          "description": "Optional JSONL file path for model telemetry debugging. Leave empty to keep telemetry ephemeral in the VS Code session."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "releasepilot.scanRepository",
          "when": "view == releasepilot.items",
          "group": "navigation"
        },
        {
          "command": "releasepilot.refreshRepository",
          "when": "view == releasepilot.items",
          "group": "navigation"
        },
        {
          "command": "releasepilot.refreshItems",
          "when": "view == releasepilot.items",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "releasepilot.markItemReady",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "inline"
        },
        {
          "command": "releasepilot.markItemNeedsReview",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "inline"
        },
        {
          "command": "releasepilot.hideItem",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "inline"
        },
        {
          "command": "releasepilot.editItemSummary",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "navigation"
        },
        {
          "command": "releasepilot.suggestItemSummary",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "inline"
        },
        {
          "command": "releasepilot.requestModelInput",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "navigation"
        },
        {
          "command": "releasepilot.acceptItem",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "inline"
        },
        {
          "command": "releasepilot.unhideItem",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "navigation"
        },
        {
          "command": "releasepilot.resetItemSummary",
          "when": "view == releasepilot.items && viewItem == releasepilot.item",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
