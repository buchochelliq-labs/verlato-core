{
    "verlato.modelProvider": "ollama",
    "verlato.ollamaModel": "gemma4",
    "verlato.ollamaEndpoint": "http://127.0.0.1:11434/api/chat",
    "verlato.maxModelItems": 1,
    "verlato.suggestionCount": 1,
    "verlato.telemetry.includeReasoningPayloads": true,
    "verlato.telemetry.includePromptPayloads": true,
    "verlato.ollamaSuggestionModel": "gemma4:e2b",
    "verlato.ollamaTimeoutSeconds": 120,
    "verlato.suggestionParallelism": 1,
    "verlato.suggestionBatchSize": 1,
    "verlato.suggestionStrategy": "tool-retrieval",
    "verlato.modelPrivacy": "local-summary-then-ai",
    "verlato.allowRemotePatches": false,
    "verlato.commitIntentInference": true,
    "verlato.suggestionPromptProfile": "conservative",
    "verlato.suggestionAdaptiveRecommendations": true,
    "verlato.suggestionTone": "release-note",
    "chat.mcp.serverSampling": {
        "release-pilot/.vscode/mcp.json: verlato": {
            "allowedModels": [
                "copilotcli/gpt-4.1",
                "copilot/gpt-4.1",
                "copilot/gpt-4o",
                "copilotcli/gpt-5-mini",
                "copilot/gpt-5-mini"
            ]
        }
    }
}