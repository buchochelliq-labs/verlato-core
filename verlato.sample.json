{
  "state_path": ".verlato_state.json",
  "diff_engine": "intentumdiff",
  "semantic_cache_path": ".verlato_semantic_cache.json",
  "semantic_parallelism": null,
  "suggestion_cache_backend": "json",
  "suggestion_cache_path": ".verlato_suggestion_cache.json",
  "suggestion_cache_ttl_days": 30,
  "feedback_include_text": false,
  "suggestion_count": 1,
  "suggestion_parallelism": 1,
  "suggestion_batch_size": 5,
  "suggestion_strategy": "auto",
  "suggestion_prompt_profile": "conservative",
  "suggestion_adaptive_recommendations": false,
  "suggestion_tone": "release-note",
  "suggestion_style": {
    "guidance": "Prefer concrete user workflow language.",
    "project_vocabulary": [
      "Release Control"
    ],
    "banned_phrases": [
      "various improvements"
    ],
    "specificity_floor": 0
  },
  "provider": {
    "name": "ollama",
    "model": "gemma4:latest",
    "suggest_model": null,
    "endpoint": "http://127.0.0.1:11434/api/chat",
    "timeout_seconds": 15,
    "keep_alive": "10m",
    "summary_num_predict": 180,
    "classify_num_predict": 24,
    "suggest_num_predict": null,
    "suggest_think": false,
    "max_items_per_scan": 25,
    "api_key_env": null,
    "plugin_manifest": {
      "id": "example-plugin",
      "display_name": "Example Plugin",
      "command": [
        "example-plugin-command"
      ],
      "config_schema": {
        "type": "object"
      },
      "capabilities": {
        "tasks": [
          "suggest",
          "summarize",
          "classify"
        ],
        "streaming": false,
        "structured_json": true,
        "location": "local",
        "auth": "env",
        "health_probe": true,
        "context_window": null
      }
    },
    "plugin_config": {},
    "plugin_env": [],
    "fallbacks": []
  },
  "targets": {
    "changelog": {
      "path": "CHANGELOG.md",
      "format": "changelog"
    },
    "github-release": {
      "path": ".github/release.md",
      "format": "github-release"
    }
  }
}
