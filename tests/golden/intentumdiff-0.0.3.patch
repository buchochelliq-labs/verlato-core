+MAX_PARAMETER_SCAN_CHARS = 4000
+
+
+def _parameter_list(definition: str) -> list[str] | None:
+    open_at = definition.find("(")
+    if open_at < 0:
+        return None
+    pieces: list[str] = []
+    current: list[str] = []
+    depth = 0
+    quote: str | None = None
+    for ch in definition[open_at + 1 :][:MAX_PARAMETER_SCAN_CHARS]:
+        if quote:
+            current.append(ch)
+            if ch == quote:
+                quote = None
+            continue
+        if ch in "\"'`":
+            quote = ch
+        elif ch in "([{<":
+            depth += 1
+        elif ch in ")]}" and depth == 0:
+            pieces.append("".join(current))
+            return [" ".join(piece.split()) for piece in pieces if piece.split()]
+        elif ch in ")]}>":
+            depth = max(0, depth - 1)
+        elif ch == "," and depth == 0:
+            pieces.append("".join(current))
+            current = []
+            continue
+        current.append(ch)
+    return None
+
+
+def _is_omittable_parameter(parameter: str) -> bool:
+    name = re.split(r"[:=]", parameter, maxsplit=1)[0].strip()
+    return parameter.startswith("*") or parameter.startswith("...") or name.endswith("?") or "=" in parameter
+
+
+def _signature_change_kind(old: Any, new: Any, old_content: Any, new_content: Any) -> str:
+    """Classify an engine CHANGE_SIGNATURE (core #297); mirrors the native runtime."""
+
+    def facts(node: Any, key: str) -> int | None:
+        value = getattr(getattr(node, "facts", None), key, None)
+        return value if isinstance(value, int) else None
+
+    old_count, old_defaults = facts(old, "param_count"), facts(old, "default_count")
+    new_count, new_defaults = facts(new, "param_count"), facts(new, "default_count")
+    if old_count is None or old_defaults is None or new_count is None or new_defaults is None:
+        return "signature"
+    old_required, new_required = old_count - old_defaults, new_count - new_defaults
+    if new_count <= old_count:
+        return "signature"
+    old_lines, new_lines = _source_lines(old_content), _source_lines(new_content)
+    if old_lines is None or new_lines is None:
+        return "signature"
+    old_text = _node_source(old, old_lines, limit=None)
+    new_text = _node_source(new, new_lines, limit=None)
+    old_params = _parameter_list(old_text) if old_text else None
+    new_params = _parameter_list(new_text) if new_text else None
+    if old_params is None or new_params is None:
+        return "signature"
+    added = new_params[len(old_params) :]
+    appended = (
+        len(new_params) > len(old_params)
+        and new_params[: len(old_params)] == old_params
+        and all(_is_omittable_parameter(p) for p in added)
+    )
+    added_variadic = sum(1 for p in added if p.startswith("*") or p.startswith("..."))
+    return "extended" if appended and new_required - added_variadic <= old_required else "signature"
+
